{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil público e controlado do usuário no Hikari",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "bannerUrl": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 500 },
        "isPrivate": { "type": "boolean" },
        "showCommentsOnProfile": { "type": "boolean" },
        "privacySettings": { "type": "object" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "avatarUrl", "bannerUrl", "bio", "isPrivate", "showCommentsOnProfile", "privacySettings", "followersCount", "followingCount", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Conversa privada entre dois participantes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participants": { "type": "array" },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "object" },
        "unreadCounts": { "type": "object" },
        "lastReadAtByUser": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants", "participantDetails", "unreadCounts", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Mensagem direta de texto, imagem, GIF ou link",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "senderUsername": { "type": "string", "maxLength": 32 },
        "senderAvatarUrl": { "type": "string", "maxLength": 2048 },
        "recipientId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "text": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["text", "image", "gif", "link"] },
        "mediaUrl": { "type": "string", "maxLength": 6000000 },
        "mediaMetadata": { "type": "object" },
        "linkPreview": { "type": "object" },
        "reactions": { "type": "object" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderId", "senderName", "senderAvatarUrl", "recipientId", "text", "type", "isRead", "createdAt"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Configurações e auditorias do sistema exclusivas da conta proprietária",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "updatedAt"]
    },
    "AnimeStorageManifest": {
      "title": "AnimeStorageManifest",
      "description": "Manifesto do particionamento escalável de animes em blocos (Etapa 3)",
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "storageEngine": { "type": "string" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "totalAnimes": { "type": "integer" },
        "chunkIds": { "type": "array" },
        "chunkCounts": { "type": "object" },
        "statusCounts": { "type": "object" },
        "migratedFromLegacy": { "type": "boolean" },
        "legacyItemCount": { "type": "integer" },
        "updatedAtMs": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version", "storageEngine", "ownerUid", "totalAnimes", "chunkIds", "chunkCounts", "statusCounts", "migratedFromLegacy", "updatedAtMs"]
    },
    "AnimeChunk": {
      "title": "AnimeChunk",
      "description": "Bloco particionado de animes (aproximadamente 300 itens)",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "chunkId": { "type": "string", "maxLength": 128 },
        "chunkIndex": { "type": "integer" },
        "animes": { "type": "array" },
        "count": { "type": "integer" },
        "updatedAtMs": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "chunkId", "chunkIndex", "animes", "count", "updatedAtMs"]
    },
    "PublicProjectionDoc": {
      "title": "PublicProjectionDoc",
      "description": "Documento sanitizado da projeção pública do perfil e blocos públicos de animes",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "updatedAtMs": { "type": "integer" }
      },
      "required": ["ownerUid", "updatedAtMs"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Notificação individual isolada por destinatário",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["new_follower", "follow_request", "request_accepted"] },
        "actor": { "type": "object" },
        "message": { "type": "string", "maxLength": 240 },
        "isRead": { "type": "boolean" },
        "createdAtTimestamp": { "type": "integer" }
      },
      "required": ["id", "recipientUid", "type", "actor", "message", "isRead", "createdAtTimestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfis públicos e metadados dos usuários"
    },
    "/users/{userId}/public_projection/{projId}": {
      "schema": { "$ref": "#/entities/PublicProjectionDoc" },
      "description": "Projeção pública sanitizada e particionada (bloqueada se isPrivate == true)"
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Notificações privadas do destinatário"
    },
    "/users/{userId}/anime_storage/{docId}": {
      "schema": { "$ref": "#/entities/AnimeStorageManifest" },
      "description": "Manifesto do armazenamento em blocos particionados"
    },
    "/users/{userId}/anime_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/AnimeChunk" },
      "description": "Blocos individuais particionados de animes"
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversas privadas entre 2 participantes"
    },
    "/conversations/{convId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Mensagens individuais de uma conversa"
    },
    "/admin/{docId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "Documentos e configurações administrativas protegidas"
    }
  }
}
