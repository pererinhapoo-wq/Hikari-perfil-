# Configuração pública do SDK Web do Firebase — Projeto: hikari-user-profiles
# Copie este arquivo para ".env.local" (ignorado pelo Git) e preencha os valores obtidos
# nas Configurações do Projeto > Seus aplicativos (Web) no Console do Firebase.
# NUNCA inclua chaves privadas de Service Account (Firebase Admin SDK) no frontend.

# Obrigatórias para inicializar Firebase Authentication e Cloud Firestore:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hikari-user-profiles.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hikari-user-profiles
VITE_FIREBASE_APP_ID=

# Padrão do aplicativo Web registrado no Firebase:
VITE_FIREBASE_STORAGE_BUCKET=hikari-user-profiles.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Opcionais (Analytics não é requisito para autenticação):
VITE_FIREBASE_MEASUREMENT_ID=
# Opcional: defina apenas se utilizar um banco Firestore nomeado diferente de "(default)"
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
