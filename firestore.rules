rules_version = '2';

// Regras restritivas para o projeto Firebase "hikari-user-profiles" (Hikari — Perfis de Usuários).
// IMPORTANTE: Arquivo preparado localmente no repositório; requer publicação explícita no Console/CLI do Firebase.
// Nenhum acesso público irrestrito ("if true") é permitido.

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Bloqueio global por padrão (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers reutilizáveis
    function isSignedIn() {
      return request.auth != null
        && (!('firebase' in request.auth.token) || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identificação exclusiva da conta administradora proprietária (Zero-Trust)
    function isSystemAdmin() {
      return isSignedIn() && request.auth.uid == 'TLJx2QuEv4QQYoduGqn0LDJxxRW2';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPrivacySettings(settings) {
      return settings is map
        && settings.keys().hasAll([
          'showAnimeList',
          'showFavorites',
          'showActivity',
          'showCommentsOnProfile'
        ])
        && (
          settings.keys().hasOnly([
            'showAnimeList',
            'showFavorites',
            'showActivity',
            'showCommentsOnProfile'
          ])
          || settings.keys().hasOnly([
            'showAnimeList',
            'showFavorites',
            'showActivity',
            'showCommentsOnProfile',
            'allowDirectMessages',
            'directMessagesFrom'
          ])
          || settings.keys().hasOnly([
            'showAnimeList',
            'showFavorites',
            'showActivity',
            'showCommentsOnProfile',
            'allowDirectMessages',
            'directMessagesFrom',
            'showOnlineStatus'
          ])
        )
        && settings.showAnimeList is bool
        && settings.showFavorites is bool
        && settings.showActivity is bool
        && settings.showCommentsOnProfile is bool
        && (!('allowDirectMessages' in settings) || settings.allowDirectMessages is bool)
        && (!('directMessagesFrom' in settings) || (settings.directMessagesFrom in ['everyone', 'followers', 'mutual']))
        && (!('showOnlineStatus' in settings) || settings.showOnlineStatus is bool);
    }

    function getOtherParticipant(participants, myUid) {
      return participants[0] == myUid ? participants[1] : participants[0];
    }

    function isValidUnreadCounts(counts, participants) {
      return counts is map
        && counts.keys().hasAll(participants)
        && counts.keys().hasOnly(participants)
        && counts[participants[0]] is int
        && counts[participants[0]] >= 0
        && counts[participants[1]] is int
        && counts[participants[1]] >= 0;
    }

    function isValidReadTimestamps(data, participants) {
      return data is map
        && data.keys().hasOnly(participants)
        && (!(participants[0] in data) || (data[participants[0]] is int && data[participants[0]] >= 0))
        && (!(participants[1] in data) || (data[participants[1]] is int && data[participants[1]] >= 0));
    }

    function isValidLastMessageSnippet(lastMsg, participants) {
      return lastMsg is map
        && lastMsg.keys().hasAll([
          'id',
          'text',
          'senderId',
          'senderName',
          'type',
          'createdAt',
          'isRead'
        ])
        && lastMsg.keys().hasOnly([
          'id',
          'text',
          'senderId',
          'senderName',
          'type',
          'createdAt',
          'isRead'
        ])
        && isValidId(lastMsg.id)
        && lastMsg.text is string
        && lastMsg.text.size() <= 2000
        && (lastMsg.senderId in participants)
        && lastMsg.senderName is string
        && lastMsg.senderName.size() >= 1
        && lastMsg.senderName.size() <= 60
        && (lastMsg.type in ['text', 'image', 'gif', 'link'])
        && lastMsg.createdAt is timestamp
        && lastMsg.isRead is bool;
    }

    function isValidConversation(data) {
      return data.keys().hasAll([
          'id',
          'participants',
          'participantDetails',
          'unreadCounts',
          'createdAt',
          'updatedAt'
        ])
        && (
          data.keys().hasOnly([
            'id',
            'participants',
            'participantDetails',
            'lastMessage',
            'unreadCounts',
            'createdAt',
            'updatedAt'
          ])
          || data.keys().hasOnly([
            'id',
            'participants',
            'participantDetails',
            'lastMessage',
            'unreadCounts',
            'lastReadAtByUser',
            'createdAt',
            'updatedAt'
          ])
        )
        && isValidId(data.id)
        && data.participants is list
        && data.participants.size() == 2
        && isValidId(data.participants[0])
        && isValidId(data.participants[1])
        && data.participants[0] != data.participants[1]
        && data.participantDetails is map
        && isValidUnreadCounts(data.unreadCounts, data.participants)
        && (!('lastMessage' in data) || isValidLastMessageSnippet(data.lastMessage, data.participants))
        && (!('lastReadAtByUser' in data) || isValidReadTimestamps(data.lastReadAtByUser, data.participants))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data, convId) {
      return data.keys().hasAll([
          'id',
          'conversationId',
          'senderId',
          'senderName',
          'senderAvatarUrl',
          'recipientId',
          'text',
          'type',
          'isRead',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'conversationId',
          'senderId',
          'senderName',
          'senderUsername',
          'senderAvatarUrl',
          'recipientId',
          'text',
          'type',
          'mediaUrl',
          'mediaMetadata',
          'linkPreview',
          'reactions',
          'isRead',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.conversationId == convId
        && isValidId(data.senderId)
        && isValidId(data.recipientId)
        && data.senderId != data.recipientId
        && data.senderId == request.auth.uid
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 60
        && data.senderAvatarUrl is string
        && data.senderAvatarUrl.size() <= 2048
        && data.text is string
        && data.text.size() <= 2000
        && data.type in ['text', 'image', 'gif', 'link']
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 6000000))
        && (!('reactions' in data) || data.reactions is map)
        && data.isRead is bool
        && data.createdAt == request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'username',
          'displayName',
          'avatarUrl',
          'bannerUrl',
          'bio',
          'isPrivate',
          'showCommentsOnProfile',
          'privacySettings',
          'followersCount',
          'followingCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'displayName',
          'avatarUrl',
          'bannerUrl',
          'bio',
          'isPrivate',
          'showCommentsOnProfile',
          'privacySettings',
          'followersCount',
          'followingCount',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 32
        && data.username.matches('^[a-zA-Z0-9_]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.avatarUrl is string
        && data.avatarUrl.size() <= 2048
        && data.bannerUrl is string
        && data.bannerUrl.size() <= 2048
        && data.bio is string
        && data.bio.size() <= 500
        && data.isPrivate is bool
        && data.showCommentsOnProfile is bool
        && isValidPrivacySettings(data.privacySettings)
        && data.followersCount is int
        && data.followersCount >= 0
        && data.followingCount is int
        && data.followingCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidImportCheckpoint(data, userId, checkpointId) {
      return data.keys().hasAll([
          'provider',
          'accountIdentifier',
          'profileId',
          'status',
          'version',
          'cursor',
          'updatedAtMs'
        ])
        && data.keys().hasOnly([
          'provider',
          'accountIdentifier',
          'profileId',
          'status',
          'version',
          'cursor',
          'updatedAtMs',
          'page',
          'recordsReceived',
          'recordsProcessed',
          'recordsConfirmed',
          'recordsPersisted',
          'addedCount',
          'updatedCount',
          'unchangedCount',
          'preservedFieldsCount',
          'totalEstimated',
          'lastConfirmedCheckpoint',
          'lastConfirmedPoint',
          'lastUpdated',
          'errorMessage',
          'lastError',
          'storageSource',
          'storageError'
        ])
        && data.provider in ['mal', 'anilist']
        && ((data.provider == 'mal' && checkpointId.matches('^mal_[a-zA-Z0-9_\\-]+$')) || (data.provider == 'anilist' && checkpointId.matches('^anilist_[a-zA-Z0-9_\\-]+$')))
        && data.profileId is string
        && data.profileId == userId
        && data.accountIdentifier is string
        && data.accountIdentifier.size() >= 1
        && ((data.provider == 'mal' && data.accountIdentifier.size() <= 124) || (data.provider == 'anilist' && data.accountIdentifier.size() <= 120))
        && data.status in ['idle', 'in_progress', 'paused', 'error', 'completed']
        && data.version is int
        && data.version >= 1
        && data.cursor is int
        && data.cursor >= 0
        && data.updatedAtMs is int
        && data.updatedAtMs >= 0
        && (!('page' in data) || (data.page is int && data.page >= 0))
        && (!('recordsReceived' in data) || (data.recordsReceived is int && data.recordsReceived >= 0))
        && (!('recordsProcessed' in data) || (data.recordsProcessed is int && data.recordsProcessed >= 0))
        && (!('recordsConfirmed' in data) || (data.recordsConfirmed is int && data.recordsConfirmed >= 0))
        && (!('recordsPersisted' in data) || (data.recordsPersisted is int && data.recordsPersisted >= 0))
        && (!('addedCount' in data) || (data.addedCount is int && data.addedCount >= 0))
        && (!('updatedCount' in data) || (data.updatedCount is int && data.updatedCount >= 0))
        && (!('unchangedCount' in data) || (data.unchangedCount is int && data.unchangedCount >= 0))
        && (!('preservedFieldsCount' in data) || (data.preservedFieldsCount is int && data.preservedFieldsCount >= 0))
        && (!('totalEstimated' in data) || data.totalEstimated == null || (data.totalEstimated is int && data.totalEstimated >= 0))
        && (!('lastConfirmedCheckpoint' in data) || data.lastConfirmedCheckpoint == null || (data.lastConfirmedCheckpoint is int && data.lastConfirmedCheckpoint >= 0))
        && (!('lastConfirmedPoint' in data) || (data.lastConfirmedPoint is string && data.lastConfirmedPoint.size() <= 128))
        && (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 128))
        && (!('errorMessage' in data) || data.errorMessage == null || (data.errorMessage is string && data.errorMessage.size() <= 2000))
        && (!('lastError' in data) || data.lastError == null || (data.lastError is string && data.lastError.size() <= 2000))
        && (!('storageSource' in data) || data.storageSource in ['local', 'remote', 'reconciled', 'memory'])
        && (!('storageError' in data) || data.storageError == null || (data.storageError is string && data.storageError.size() <= 2000))
        && !('idToken' in data)
        && !('accessToken' in data)
        && !('refreshToken' in data)
        && !('token' in data)
        && !('animes' in data)
        && !('workingAnimes' in data)
        && !('mergedAnimes' in data);
    }

    // 2. Documento principal do perfil público/controlado do usuário (sem PII como e-mail)
    match /users/{userId} {
      // Apenas o próprio dono lê perfis privados; perfis marcados como públicos exigem sessão autenticada
      allow get: if isValidId(userId) && (
        isOwner(userId) || (isSignedIn() && existing().isPrivate == false)
      );

      allow list: if isSignedIn() && (
        existing().uid == request.auth.uid || existing().isPrivate == false
      );

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().followersCount == existing().followersCount
        && incoming().followingCount == existing().followingCount
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username',
          'displayName',
          'avatarUrl',
          'bannerUrl',
          'bio',
          'isPrivate',
          'showCommentsOnProfile',
          'privacySettings',
          'updatedAt'
        ]);

      allow delete: if false;

      // 3. Subcoleção estritamente privada para dados sensíveis (PII, ex.: e-mail)
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'account';
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && docId == 'account'
          && incoming().keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
          && incoming().uid == userId
          && incoming().email is string
          && incoming().email.size() <= 254
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && docId == 'account'
          && incoming().keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().email is string
          && incoming().email.size() <= 254
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      // 4. Subcoleção da lista de animes do usuário (escrita exclusiva do dono)
      match /animeList/{animeId} {
        allow get: if isValidId(userId) && isValidId(animeId) && (
          isOwner(userId) || (
            isSignedIn()
            && get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false
            && get(/databases/$(database)/documents/users/$(userId)).data.privacySettings.showAnimeList == true
          )
        );
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(animeId)
          && incoming().keys().hasAll([
            'id',
            'ownerUid',
            'title',
            'posterUrl',
            'status',
            'currentEpisode',
            'totalEpisodes',
            'rating',
            'isFavorite',
            'year',
            'genres',
            'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'id',
            'ownerUid',
            'title',
            'titleRomaji',
            'posterUrl',
            'status',
            'currentEpisode',
            'totalEpisodes',
            'rating',
            'isFavorite',
            'year',
            'genres',
            'episodeDurationMinutes',
            'rewatchCount',
            'updatedAt'
          ])
          && incoming().id == animeId
          && incoming().ownerUid == userId
          && incoming().title is string
          && incoming().title.size() >= 1
          && incoming().title.size() <= 200
          && incoming().posterUrl is string
          && incoming().posterUrl.size() <= 2048
          && incoming().status in ['watching', 'completed', 'planned', 'on_hold', 'dropped']
          && incoming().currentEpisode is int
          && incoming().currentEpisode >= 0
          && incoming().totalEpisodes is int
          && incoming().totalEpisodes >= 0
          && incoming().rating is number
          && incoming().rating >= 0
          && incoming().rating <= 10
          && incoming().isFavorite is bool
          && incoming().year is int
          && incoming().genres is list
          && incoming().genres.size() <= 15
          && incoming().updatedAt == request.time;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(animeId);
      }

      // 5. Subcoleção de atividades recentes do usuário (escrita exclusiva do dono)
      match /activities/{activityId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(activityId)
          && incoming().keys().hasAll(['id', 'ownerUid', 'type', 'title', 'description', 'createdAt'])
          && incoming().keys().hasOnly(['id', 'ownerUid', 'type', 'title', 'description', 'score', 'episode', 'createdAt'])
          && incoming().id == activityId
          && incoming().ownerUid == userId
          && incoming().type in ['watched_ep', 'completed_anime', 'rated', 'commented', 'added_favorite', 'status_changed', 'added_anime']
          && incoming().title is string
          && incoming().title.size() >= 1
          && incoming().title.size() <= 240
          && incoming().description is string
          && incoming().description.size() <= 300
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }

      // 6. Subcoleção de notificações do usuário (leitura exclusiva pelo destinatário; criação validada com ator autenticado)
      match /notifications/{notifId} {
        allow get, list: if isOwner(userId);
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(notifId)
          && request.auth.uid != userId
          && notifId.matches('^notif_(follow|follow_back|req|accepted)_[a-zA-Z0-9_\\-]+$')
          && incoming().keys().hasAll(['id', 'recipientUid', 'type', 'actor', 'message', 'isRead', 'createdAtTimestamp'])
          && incoming().id == notifId
          && incoming().recipientUid == userId
          && incoming().type in ['new_follower', 'follow_request', 'request_accepted']
          && incoming().actor is map
          && incoming().actor.id == request.auth.uid
          && incoming().message is string
          && incoming().message.size() <= 240
          && incoming().isRead == false
          && incoming().createdAtTimestamp is int;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(notifId)
          && incoming().recipientUid == existing().recipientUid
          && incoming().recipientUid == userId
          && incoming().isRead is bool
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'handled']);
        allow delete: if false;
      }

      // 6.1 Projeção pública sanitizada em blocos (bloqueada automaticamente no banco quando /users/{userId}.isPrivate == true)
      match /public_projection/{projId} {
        allow get, list: if isValidId(userId) && (
          isOwner(userId) || (
            isSignedIn()
            && get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false
          )
        );
        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(projId)
          && incoming().ownerUid == userId
          && incoming().updatedAtMs is int
          && incoming().updatedAtMs >= 0;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(projId);
      }

      // 7. Subcoleção de metadados e manifesto do armazenamento em blocos escaláveis (Etapa 3)
      match /anime_storage/{docId} {
        allow get: if isValidId(userId) && docId == 'manifest' && isOwner(userId);
        allow list: if false;
        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && docId == 'manifest'
          && incoming().ownerUid == userId
          && incoming().version is int
          && incoming().storageEngine == 'chunked_v1'
          && incoming().totalAnimes is int
          && incoming().totalAnimes >= 0
          && incoming().chunkIds is list
          && incoming().chunkIds.size() <= 500
          && incoming().chunkCounts is map
          && incoming().statusCounts is map
          && incoming().migratedFromLegacy is bool
          && incoming().updatedAtMs is int
          && incoming().updatedAtMs >= 0;
        allow delete: if false;
      }

      // 8. Subcoleção de blocos particionados de animes (~300 animes por doc, limite estrito de 450 para garantir < 200 KiB)
      // Acesso de leitura e escrita restrito estritamente ao proprietário (Zero-Trust) em alinhamento com anime_storage/manifest.
      // O perfil público consome a projeção pública sanitizada (PublicProfileProjection) para exibição segura sem expor dados internos.
      match /anime_chunks/{chunkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(chunkId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(chunkId)
          && incoming().ownerUid == userId
          && incoming().chunkId == chunkId
          && incoming().chunkIndex is int
          && incoming().chunkIndex >= 0
          && incoming().animes is list
          && incoming().animes.size() <= 450
          && incoming().count is int
          && incoming().count >= 0
          && incoming().updatedAtMs is int
          && incoming().updatedAtMs >= 0;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chunkId);
      }

      // 9. Espaço pessoal isolado por UID (/users/{userId}/workspace/personal — compatibilidade retroativa e rollback seguro)
      match /workspace/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'personal';
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && docId == 'personal'
          && incoming().keys().hasAll([
            'uid',
            'profileOverrides',
            'animes',
            'favoriteCharacters',
            'favoriteCompanies',
            'favoritePeople',
            'comments',
            'activities',
            'notifications',
            'followers',
            'following',
            'followRequests',
            'followingIds',
            'requestedIds',
            'blockedIds',
            'updatedAtMs',
            'createdAt',
            'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'uid',
            'profileOverrides',
            'animes',
            'favoriteCharacters',
            'favoriteCompanies',
            'favoritePeople',
            'comments',
            'activities',
            'notifications',
            'followers',
            'following',
            'followRequests',
            'followingIds',
            'requestedIds',
            'blockedIds',
            'updatedAtMs',
            'createdAt',
            'updatedAt'
          ])
          && incoming().uid is string
          && incoming().uid == userId
          && incoming().profileOverrides is map
          && incoming().animes is list
          && incoming().animes.size() <= 2000
          && incoming().favoriteCharacters is list
          && incoming().favoriteCharacters.size() <= 50
          && incoming().favoriteCompanies is list
          && incoming().favoriteCompanies.size() <= 50
          && incoming().favoritePeople is list
          && incoming().favoritePeople.size() <= 50
          && incoming().comments is list
          && incoming().comments.size() <= 1000
          && incoming().activities is list
          && incoming().activities.size() <= 1000
          && incoming().notifications is list
          && incoming().notifications.size() <= 500
          && incoming().followers is list
          && incoming().followers.size() <= 2000
          && incoming().following is list
          && incoming().following.size() <= 2000
          && incoming().followRequests is list
          && incoming().followRequests.size() <= 500
          && incoming().followingIds is list
          && incoming().followingIds.size() <= 2000
          && incoming().requestedIds is list
          && incoming().requestedIds.size() <= 500
          && incoming().blockedIds is list
          && incoming().blockedIds.size() <= 500
          && incoming().updatedAtMs is int
          && incoming().updatedAtMs >= 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && docId == 'personal'
          && incoming().keys().hasAll([
            'uid',
            'profileOverrides',
            'animes',
            'favoriteCharacters',
            'favoriteCompanies',
            'favoritePeople',
            'comments',
            'activities',
            'notifications',
            'followers',
            'following',
            'followRequests',
            'followingIds',
            'requestedIds',
            'blockedIds',
            'updatedAtMs',
            'createdAt',
            'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'uid',
            'profileOverrides',
            'animes',
            'favoriteCharacters',
            'favoriteCompanies',
            'favoritePeople',
            'comments',
            'activities',
            'notifications',
            'followers',
            'following',
            'followRequests',
            'followingIds',
            'requestedIds',
            'blockedIds',
            'updatedAtMs',
            'createdAt',
            'updatedAt'
          ])
          && incoming().uid == existing().uid
          && incoming().uid == userId
          && incoming().createdAt == existing().createdAt
          && incoming().profileOverrides is map
          && incoming().animes is list
          && incoming().animes.size() <= 2000
          && incoming().favoriteCharacters is list
          && incoming().favoriteCharacters.size() <= 50
          && incoming().favoriteCompanies is list
          && incoming().favoriteCompanies.size() <= 50
          && incoming().favoritePeople is list
          && incoming().favoritePeople.size() <= 50
          && incoming().comments is list
          && incoming().comments.size() <= 1000
          && incoming().activities is list
          && incoming().activities.size() <= 1000
          && incoming().notifications is list
          && incoming().notifications.size() <= 500
          && incoming().followers is list
          && incoming().followers.size() <= 2000
          && incoming().following is list
          && incoming().following.size() <= 2000
          && incoming().followRequests is list
          && incoming().followRequests.size() <= 500
          && incoming().followingIds is list
          && incoming().followingIds.size() <= 2000
          && incoming().requestedIds is list
          && incoming().requestedIds.size() <= 500
          && incoming().blockedIds is list
          && incoming().blockedIds.size() <= 500
          && incoming().updatedAtMs is int
          && incoming().updatedAtMs >= 0
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }

      // 10. Subcoleção privada de checkpoints de importação MAL e AniList (Etapa 4.1)
      match /import_checkpoints/{checkpointId} {
        allow get, list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(checkpointId)
          && isValidImportCheckpoint(incoming(), userId, checkpointId);

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(checkpointId)
          && isValidImportCheckpoint(incoming(), userId, checkpointId)
          && incoming().profileId == existing().profileId
          && incoming().provider == existing().provider
          && incoming().accountIdentifier == existing().accountIdentifier;

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(checkpointId);
      }
    }

    // 8. Coleção de conversas privadas e mensagens diretas (acesso restrito aos 2 participantes)
    match /conversations/{convId} {
      allow get: if isSignedIn()
        && isValidId(convId)
        && (
          (resource != null && (request.auth.uid in resource.data.participants))
          || (resource == null && (
            convId.matches('^conv_' + request.auth.uid + '__[a-zA-Z0-9_\\-]+$')
            || convId.matches('^conv_[a-zA-Z0-9_\\-]+__' + request.auth.uid + '$')
          ))
        );

      allow list: if isSignedIn()
        && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && isValidId(convId)
        && isValidConversation(incoming())
        && (request.auth.uid in incoming().participants)
        && (
          convId == ('conv_' + incoming().participants[0] + '__' + incoming().participants[1])
          || convId == ('conv_' + incoming().participants[1] + '__' + incoming().participants[0])
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // Caso A: Criação de conversa vazia (ambos os contadores zerados, sem lastMessage)
          (
            !('lastMessage' in incoming())
            && incoming().unreadCounts[incoming().participants[0]] == 0
            && incoming().unreadCounts[incoming().participants[1]] == 0
          )
          // Caso B: Criação atômica com primeira mensagem no mesmo writeBatch
          || (
            ('lastMessage' in incoming())
            && incoming().lastMessage.senderId == request.auth.uid
            && incoming().unreadCounts[request.auth.uid] == 0
            && incoming().unreadCounts[getOtherParticipant(incoming().participants, request.auth.uid)] == 1
            && existsAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id))
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.senderId == request.auth.uid
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.recipientId == getOtherParticipant(incoming().participants, request.auth.uid)
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.text == incoming().lastMessage.text
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.type == incoming().lastMessage.type
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.createdAt == incoming().lastMessage.createdAt
          )
        );

      allow update: if isSignedIn()
        && isValidId(convId)
        && isValidConversation(incoming())
        && (request.auth.uid in resource.data.participants)
        && incoming().participants == existing().participants
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Operação 1: Envio de Mensagem (remetente atualiza lastMessage, incrementa unreadCount do destinatário em exatamente 1, e valida mensagem real no mesmo batch)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'unreadCounts', 'updatedAt'])
            && ('lastMessage' in incoming())
            && incoming().lastMessage.senderId == request.auth.uid
            && incoming().unreadCounts[request.auth.uid] == existing().unreadCounts[request.auth.uid]
            && incoming().unreadCounts[getOtherParticipant(resource.data.participants, request.auth.uid)] == existing().unreadCounts[getOtherParticipant(resource.data.participants, request.auth.uid)] + 1
            && existsAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id))
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.senderId == request.auth.uid
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.recipientId == getOtherParticipant(resource.data.participants, request.auth.uid)
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.text == incoming().lastMessage.text
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.type == incoming().lastMessage.type
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(incoming().lastMessage.id)).data.createdAt == incoming().lastMessage.createdAt
          )
          // Operação 2: Leitura de Mensagens (usuário zera exclusivamente seu próprio unreadCount e atualiza apenas seu lastReadAtByUser)
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['unreadCounts', 'lastReadAtByUser', 'updatedAt'])
            && incoming().unreadCounts[request.auth.uid] == 0
            && incoming().unreadCounts[getOtherParticipant(resource.data.participants, request.auth.uid)] == existing().unreadCounts[getOtherParticipant(resource.data.participants, request.auth.uid)]
            // Não pode remover o mapa lastReadAtByUser se ele já existia no documento
            && (!('lastReadAtByUser' in existing()) || ('lastReadAtByUser' in incoming()))
            // Se lastReadAtByUser estiver no incoming, preserva rigorosamente a entrada do outro usuário e atualiza apenas a própria
            && (
              !('lastReadAtByUser' in incoming())
              || (
                (('lastReadAtByUser' in existing()) && (getOtherParticipant(resource.data.participants, request.auth.uid) in existing().lastReadAtByUser)
                  ? incoming().lastReadAtByUser[getOtherParticipant(resource.data.participants, request.auth.uid)] == existing().lastReadAtByUser[getOtherParticipant(resource.data.participants, request.auth.uid)]
                  : !(getOtherParticipant(resource.data.participants, request.auth.uid) in incoming().lastReadAtByUser)
                )
                && (request.auth.uid in incoming().lastReadAtByUser)
                && incoming().lastReadAtByUser[request.auth.uid] is int
                && incoming().lastReadAtByUser[request.auth.uid] >= 0
              )
            )
          )
        );

      allow delete: if false;

      // Subcoleção de mensagens individuais dentro da conversa
      match /messages/{msgId} {
        allow get: if isSignedIn()
          && isValidId(convId)
          && isValidId(msgId)
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);

        allow list: if isSignedIn()
          && isValidId(convId)
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);

        allow create: if isSignedIn()
          && isValidId(convId)
          && isValidId(msgId)
          && isValidMessage(incoming(), convId)
          && incoming().senderId == request.auth.uid
          && existsAfter(/databases/$(database)/documents/conversations/$(convId))
          && (request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          && (incoming().recipientId in getAfter(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          && incoming().recipientId != request.auth.uid;

        allow update: if isSignedIn()
          && isValidId(convId)
          && isValidId(msgId)
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) && incoming().isRead is bool)
            || (incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) && incoming().reactions is map)
          );

        allow delete: if false;
      }
    }

    // 9. Documentos e coleções exclusivas de administração do sistema (apenas a conta proprietária autorizada)
    match /system/{docId} {
      allow read, write: if isSystemAdmin() && isValidId(docId);
    }

    match /admin/{docId} {
      allow read, write: if isSystemAdmin() && isValidId(docId);
    }
  }
}
